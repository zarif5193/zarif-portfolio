{
  "name": "zarif-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "SITE_TIMEZONE": "Asia/Dhaka"
  }
}
