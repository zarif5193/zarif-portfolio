{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zarif-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "SITE_TIMEZONE": "Asia/Dhaka"
  }
}
