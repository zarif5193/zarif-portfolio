{
  "name": "zarif-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MD. Zarif Hasan — portfolio + admin panel (Cloudflare Workers, Supabase / D1 / PostgreSQL)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "preview": "node scripts/build-preview.mjs",
    "db:supabase": "echo \"Supabase Dashboard → SQL Editor-এ schema/schema.supabase.sql পেস্ট করে Run করুন\"",
    "db:d1:create": "wrangler d1 create zarif-portfolio",
    "db:d1:migrate": "wrangler d1 execute zarif-portfolio --remote --file=schema/schema.sqlite.sql",
    "db:pg:migrate": "psql \"$DATABASE_URL\" -f schema/schema.postgres.sql",
    "secrets": "node scripts/setup-secrets.mjs",
    "secrets:check": "node scripts/setup-secrets.mjs --check"
  },
  "devDependencies": {
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22"
  }
}
