# ============================================================
#  Environment variables — নমুনা ফাইল
#  ------------------------------------------------------------
#  ব্যবহার:  cp .env.example .env        (তারপর আসল মান বসান)
#  ⚠️ আসল .env ফাইল কখনো Git-এ কমিট করবেন না।
# ============================================================

# ── ডেটাবেস: Neon / Supabase Postgres / যেকোনো PostgreSQL ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── অ্যাডমিন প্যানেল (/admin) ──
ADMIN_PASSWORD=change-me
SESSION_SECRET=make-this-a-long-random-string

# ── Supabase ব্যবহার করলে (ডেটাবেস হিসেবে) ──
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Cloudflare D1 ব্যবহার করলে wrangler.toml-এ [[d1_databases]] বাইন্ড করুন ──

SITE_TIMEZONE=Asia/Dhaka
